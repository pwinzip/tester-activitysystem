# ============================================================================
#  SciDI Activity Check-in — Docker configuration
#  1) Copy:      cp .env.docker.example .env.docker
#  2) Fill in the secrets below (see the "generate with" hints)
#  3) Start:     docker compose up --build
#  This file is read by BOTH the db and web containers (docker-compose.yml).
# ============================================================================

# --- Operational profile ------------------------------------------------------
# development | assessment | production   (assessment = the class profile)
APP_MODE=assessment
NODE_ENV=production

# --- URLs (leave as-is for local Docker) -------------------------------------
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api
BETTER_AUTH_URL=http://localhost:3000

# --- Database (local container) ----------------------------------------------
# If you change POSTGRES_PASSWORD, change it inside DATABASE_URL too (same value).
POSTGRES_USER=scidi
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=scidi_activity
DATABASE_URL=postgresql://scidi:change-me-local-db-password@db:5432/scidi_activity?schema=public

# --- Secrets: GENERATE YOUR OWN ----------------------------------------------
# BETTER_AUTH_SECRET  -> run:  openssl rand -base64 48
BETTER_AUTH_SECRET=REPLACE_ME_with_openssl_rand_base64_48
# OTP_HASH_PEPPER     -> run:  openssl rand -base64 32
OTP_HASH_PEPPER=REPLACE_ME_with_openssl_rand_base64_32

# --- Email --------------------------------------------------------------------
# In test/assessment the OTP is printed to the app console, so SMTP is NOT needed
# and SMTP_* may stay blank. Set MAIL_PROVIDER=smtp only for real email delivery.
MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SciDI Activity <no-reply@example.local>

# --- OTP rules ----------------------------------------------------------------
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Assessment mode ----------------------------------------------------------
ASSESSMENT_FIXED_OTP_ENABLED=true
# Token required to run `assessment:purge`. Pick any secret string.
ASSESSMENT_CONFIRMATION_TOKEN=change-me-teacher-only-token
# test -> student{NN}@qa.local ; real -> {studentId}@tsu.ac.th
ASSESSMENT_EMAIL_MODE=test
ASSESSMENT_REAL_EMAIL_DOMAIN=tsu.ac.th
ASSESSMENT_EXPORT_DIR=/app/artifacts

LOG_LEVEL=info
