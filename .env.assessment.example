NODE_ENV="production"
APP_MODE="assessment"

PUBLIC_APP_URL="https://activityapp.course-cis.com"
NEXT_PUBLIC_APP_URL="https://activityapp.course-cis.com"
NEXT_PUBLIC_API_BASE_URL="/api"

DATABASE_URL="postgresql://scidi:change-me@db:5432/scidi_activity?schema=public"

BETTER_AUTH_URL="https://activityapp.course-cis.com"
BETTER_AUTH_SECRET="generate-a-long-random-secret-at-least-32-chars"

MAIL_PROVIDER="console"
SMTP_FROM="SciDI Activity <no-reply@course-cis.com>"

OTP_EXPIRES_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_HASH_PEPPER="assessment-pepper-random-secret"

# Assessment mode
ASSESSMENT_FIXED_OTP_ENABLED="true"
ASSESSMENT_CONFIRMATION_TOKEN="teacher-only-random-token"
ASSESSMENT_EXPORT_DIR="./artifacts"
# "test" -> student{NN}@qa.local ; "real" -> {studentId}@tsu.ac.th
ASSESSMENT_EMAIL_MODE="test"
ASSESSMENT_REAL_EMAIL_DOMAIN="tsu.ac.th"

LOG_LEVEL="info"
